<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="meridian_finance.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="923"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="general_ledger" custom_title="0" dock_id="1" table="4,14:maingeneral_ledger"/><dock_state state="000000ff00000000fd000000010000000200000139000002a6fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000001390000012400ffffff000001390000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="chart_of_accounts" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="69"/><column index="2" value="195"/><column index="3" value="140"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="department_master" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="91"/><column index="2" value="195"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="general_ledger" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="72"/><column index="2" value="85"/><column index="3" value="91"/><column index="4" value="69"/><column index="5" value="78"/><column index="6" value="78"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="monthly_budget" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="90"/><column index="2" value="91"/><column index="3" value="69"/><column index="4" value="97"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="Actual Spending *">SELECT SUBSTR(g.txn_date, 1, 7) AS month,
       d.department_name, a.account_category,
       ROUND(SUM(g.amount), 2) AS total_actual
FROM general_ledger g
JOIN department_master d USING (department_id)
JOIN chart_of_accounts a USING (account_id)
WHERE g.txn_date &gt;= '2026-01-01'
  AND g.txn_date &lt; '2026-08-01'
GROUP BY month, d.department_name, a.account_category;</sql><sql name="Budget*">SELECT SUBSTR(b.budget_month, 1, 7) AS month,
       d.department_name, a.account_category,
       SUM(b.budget_amount) AS total_budget
FROM monthly_budget b
JOIN department_master d USING (department_id)
JOIN chart_of_accounts a USING (account_id)
WHERE b.budget_month &gt;= '2026-01'
  AND b.budget_month &lt; '2026-08'
GROUP BY month, d.department_name, a.account_category;</sql><sql name="Budget Vs Actual *">WITH actual AS (
 SELECT department_id, account_id, SUM(amount) AS actual
 FROM general_ledger
 WHERE txn_date &gt;= '2026-01-01' AND txn_date &lt; '2026-08-01'
 GROUP BY department_id, account_id
),
budget AS (
 SELECT department_id, account_id, SUM(budget_amount) AS budget
 FROM monthly_budget
 WHERE budget_month &gt;= '2026-01' AND budget_month &lt; '2026-08'
 GROUP BY department_id, account_id
)
SELECT d.department_name, c.account_category,
 ROUND(SUM(COALESCE(a.actual, 0)), 2) AS actual,
 ROUND(SUM(b.budget), 2) AS budget,
 ROUND(SUM(COALESCE(a.actual, 0) - b.budget), 2) AS dollar_variance,
 ROUND(100.0 * SUM(COALESCE(a.actual, 0) - b.budget)
       / NULLIF(ABS(SUM(b.budget)), 0), 2) AS percent_variance
FROM budget b
LEFT JOIN actual a USING (department_id, account_id)
JOIN department_master d USING (department_id)
JOIN chart_of_accounts c USING (account_id)
GROUP BY d.department_name, c.account_category
ORDER BY d.department_name, c.account_category;</sql><sql name="SQL 4*">WITH actual AS (
    SELECT SUBSTR(txn_date, 1, 7) AS month,
           department_id, account_id,
           SUM(amount) AS actual
    FROM general_ledger
    WHERE txn_date &gt;= '2026-01-01'
      AND txn_date &lt; '2026-08-01'
    GROUP BY month, department_id, account_id
),
budget AS (
    SELECT SUBSTR(budget_month, 1, 7) AS month,
           department_id, account_id,
           SUM(budget_amount) AS budget
    FROM monthly_budget
    WHERE budget_month &gt;= '2026-01'
      AND budget_month &lt; '2026-08'
    GROUP BY month, department_id, account_id
)
SELECT
    b.month AS month,
    d.department_name,
    c.account_category,
    ROUND(SUM(COALESCE(a.actual, 0)), 2) AS actual,
    ROUND(SUM(b.budget), 2) AS budget,
    ROUND(SUM(COALESCE(a.actual, 0) - b.budget), 2) AS dollar_variance,
    ROUND(
        100.0 * SUM(COALESCE(a.actual, 0) - b.budget)
        / NULLIF(ABS(SUM(b.budget)), 0), 2
    ) AS percent_variance
FROM budget b
LEFT JOIN actual a
    ON b.month = a.month
    AND b.department_id = a.department_id
    AND b.account_id = a.account_id
JOIN department_master d USING (department_id)
JOIN chart_of_accounts c USING (account_id)
GROUP BY b.month, d.department_name, c.account_category
ORDER BY d.department_name, c.account_category, b.month;</sql><current_tab id="3"/></tab_sql></sqlb_project>
